# Warframe Hub (vinext app)
# Dev server port: dev.config.cjs (default 8742)
# Sentry: set NEXT_PUBLIC_DSN at runtime for Docker (see docker-compose.sample.yml).
# On Vercel, NEXT_PUBLIC_DSN may be set in project env (build-time). Prefer runtime-env.js for self-host.
NEXT_PUBLIC_DSN=
NEXT_PUBLIC_PERSIST=true
NEXT_PUBLIC_INTERVAL=30000
