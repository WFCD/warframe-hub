{
  "name": "@wfcd/hub",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/verify-static-deploy.mjs",
    "start": "vinext start --port 8742",
    "vinext:check": "vinext check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ignore-path ../../.eslintignore .",
    "lint:fix": "eslint --ignore-path ../../.eslintignore . --fix",
    "test": "npm run test:e2e && npm run test:component",
    "test:e2e": "cypress run --e2e --config-file ../../cypress.config.ts",
    "test:component": "cypress run --component --config-file ../../cypress.config.ts",
    "test:debug": "cypress open --config-file ../../cypress.config.ts",
    "test:debug:component": "cypress open --component --config-file ../../cypress.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-free": "^5.8.2",
    "@heroui/react": "^3.2.1",
    "@heroui/styles": "^3.2.1",
    "@sentry/react": "^9.28.0",
    "@wfcd/shared": "file:../../packages/shared",
    "dayjs": "^1.11.21",
    "i18next": "^25.2.1",
    "json5": "^2.2.3",
    "leaflet": "^1.9.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^15.5.2",
    "react-leaflet": "^5.0.0",
    "react-masonry-css": "^1.0.16",
    "vinext": "1.0.0-beta.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/leaflet": "^1.9.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.26",
    "cypress": "^15.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-cypress": "^3.6.0",
    "eslint-plugin-jsonc": "^2.20.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-yml": "^1.18.0",
    "jsonc-eslint-parser": "^2.4.0",
    "sass": "^1.86.3",
    "nitro": "3.0.260610-beta",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "yaml-eslint-parser": "^1.3.0"
  }
}
