{
  "name": "@wfcd/hub",
  "version": "2.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/verify-static-deploy.mjs",
    "start": "vinext start --port 8742",
    "vinext:check": "vinext check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "commitlint": "commitlint",
    "prepare": "husky",
    "test": "npm run test:e2e && npm run test:component",
    "test:e2e": "cypress run --e2e --config-file cypress.config.ts",
    "test:component": "cypress run --component --config-file cypress.config.ts",
    "test:debug": "cypress open --config-file cypress.config.ts",
    "test:debug:component": "cypress open --component --config-file cypress.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-free": "^5.8.2",
    "@heroui/react": "^3.2.1",
    "@heroui/styles": "^3.2.1",
    "@sentry/react": "^9.28.0",
    "dayjs": "^1.11.21",
    "i18next": "^25.2.1",
    "json5": "^2.2.3",
    "leaflet": "^1.9.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^15.5.2",
    "react-leaflet": "^5.0.0",
    "react-masonry-css": "^1.0.16",
    "vinext": "1.0.0-beta.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/leaflet": "^1.9.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.26",
    "cypress": "^15.18.0",
    "cypress-real-events": "^1.15.0",
    "eslint": "^10.7.0",
    "eslint-plugin-cypress": "^6.4.2",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsonc": "^3.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-yml": "^3.6.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsonc-eslint-parser": "^2.4.0",
    "lint-staged": "^17.0.7",
    "nitro": "3.0.260610-beta",
    "sass": "^1.86.3",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "yaml-eslint-parser": "^1.3.0"
  },
  "engines": {
    "node": "24"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
