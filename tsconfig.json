{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "next/dynamic": ["./node_modules/vinext/dist/shims/dynamic.js"],
      "next/link": ["./node_modules/vinext/dist/shims/link.js"],
      "next/navigation": ["./node_modules/vinext/dist/shims/navigation.js"],
      "next/font/google": ["./node_modules/vinext/dist/shims/font-google.js"],
      "next/image": ["./node_modules/vinext/dist/shims/image.js"],
      "next/headers": ["./node_modules/vinext/dist/shims/headers.js"],
      "next/cache": ["./node_modules/vinext/dist/shims/cache.js"],
      "next/script": ["./node_modules/vinext/dist/shims/script.js"],
      "next/head": ["./node_modules/vinext/dist/shims/head.js"],
      "next/router": ["./node_modules/vinext/dist/shims/router.js"],
      "next/server": ["./node_modules/vinext/dist/shims/server.js"],
      "next/document": ["./node_modules/vinext/dist/shims/document.js"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts"],
  "exclude": ["node_modules"]
}
